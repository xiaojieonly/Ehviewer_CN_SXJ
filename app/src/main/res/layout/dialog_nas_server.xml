<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/settings_nas_server_help"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <EditText
            android:id="@+id/nas_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_download_nas_host"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/nas_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_download_nas_username"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/nas_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_download_nas_password"
            android:inputType="textPassword"
            android:singleLine="true" />

        <EditText
            android:id="@+id/nas_domain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_download_nas_domain"
            android:inputType="text"
            android:singleLine="true" />

    </LinearLayout>
</ScrollView>
