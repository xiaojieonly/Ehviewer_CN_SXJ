<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/smb_config_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/smb_host"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/settings_download_smb_host"
                android:inputType="text"
                android:singleLine="true"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/smb_port"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:hint="@string/settings_download_smb_port"
                android:inputType="number"
                android:singleLine="true" />
        </LinearLayout>

        <EditText
            android:id="@+id/smb_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_download_smb_username"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/smb_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_download_smb_password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/smb_connect"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/settings_download_smb_connect"
            android:textColor="?attr/colorPrimary"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/smb_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:singleLine="true"
        android:ellipsize="start"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="@dimen/text_little_small"
        android:visibility="gone" />

    <ListView
        android:id="@+id/smb_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/smb_up"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/smb_picker_up"
            android:textColor="?attr/colorAccent"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/smb_confirm"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/ok"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
