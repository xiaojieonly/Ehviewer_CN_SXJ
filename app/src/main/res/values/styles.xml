<resources>

    <style name="ActionBarStyle" parent="@style/Widget.AppCompat.ActionBar.Solid">
        <item name="background">?attr/toolbarColor</item>
    </style>

    <!-- TextAppearance -->
    <style name="TextAppearance" parent="TextAppearance.AppCompat"></style>

    <!-- Progress View -->
    <style name="ProgressView">
        <item name="color">?attr/progressColor</item>
        <!--        <item name="android:background">@color/purple_a400</item>-->
        <item name="indeterminate">true</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="ProgressView.Small">
        <item name="android:minWidth">16dp</item>
        <item name="android:minHeight">16dp</item>
    </style>

    <style name="ProgressView.Large">
        <item name="android:minWidth">76dp</item>
        <item name="android:minHeight">76dp</item>
    </style>

    <style name="TextAppearance.CardTitle">
        <item name="android:textSize">@dimen/text_little_small</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="CardTitle">
        <item name="android:textAppearance">@style/TextAppearance.CardTitle</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:lineSpacingExtra">0sp</item>
    </style>

    <style name="TextAppearance.TopListTitle">
        <item name="android:textSize">@dimen/text_little_large</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="TopListTitle">
        <item name="android:textAppearance">@style/TextAppearance.TopListTitle</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">10</item>
        <item name="android:gravity">start</item>
    </style>

    <style name="GotoMessageStyle">
        <item name="android:textAppearance">@style/TextAppearance.GotoMessageStyle</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">10</item>
        <item name="android:gravity">start</item>
    </style>

    <style name="TextAppearance.GotoMessageStyle">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">?android:attr/textColorTertiary</item>
    </style>

    <style name="TextAppearance.TopListItem">
        <item name="android:textSize">@dimen/text_medium</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="TopListItem">
        <item name="android:textAppearance">@style/TextAppearance.TopListItem</item>
        <!--        <item name="android:ellipsize">end</item>-->
        <item name="android:maxLines">99</item>
        <item name="android:gravity">start</item>
        <item name="android:singleLine">false</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="TextAppearance.CardMessage">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="CardMessage">
        <item name="android:textAppearance">@style/TextAppearance.CardMessage</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="CardMessageMultipleLines">
        <item name="android:textAppearance">@style/TextAppearance.CardMessage</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">10</item>
    </style>

    <style name="TextAppearance.ReadProgress">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="ReadProgress">
        <item name="android:textAppearance">@style/TextAppearance.ReadProgress</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- CategoryText -->
    <style name="CategoryText">
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Subhead</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/category_table_item_height</item>
        <item name="maskColor">@color/check_text_view_mask</item>
    </style>

    <style name="TextAppearance.CategoryTitle" parent="TextAppearance.AppCompat.Small">
        <item name="android:textColor">?attr/textColorThemeAccent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CategoryTitle">
        <item name="android:textAppearance">@style/TextAppearance.CategoryTitle</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="ButtonInCard">
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="ButtonNewVersion">
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="ButtonInCard.Accent">
        <item name="android:textColor">?attr/colorAccent</item>
    </style>

    <style name="Slider">
        <item name="thickness">2dp</item>
        <item name="radius">6dp</item>
        <item name="color">?attr/widgetColorThemeAccent</item>
        <item name="textColor">@android:color/white</item>
        <item name="textSize">12sp</item>
        <item name="dark">false</item>
    </style>

    <style name="Slider.Dark">
        <item name="dark">true</item>
    </style>

    <style name="Indicating">
        <item name="indicatorHeight">1dp</item>
        <item name="indicatorColor">?attr/dividerColor</item>
    </style>

    <style name="Widget.Design.FloatingActionButton.Mini">
        <item name="fabSize">mini</item>
    </style>

    <style name="Guide.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">?attr/guideTitleColor</item>
    </style>

    <style name="Guide.Text" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textColor">?attr/guideTextColor</item>
    </style>

    <style name="Guide">
        <item name="sv_backgroundColor">?attr/guideBackgroundColor</item>
        <item name="sv_titleTextAppearance">@style/Guide.Title</item>
        <item name="sv_detailTextAppearance">@style/Guide.Text</item>
    </style>

    <style name="CardView.Normal">
        <!-- M3 卡片:12dp 圆角,1dp 阴影 -->
        <item name="cardCornerRadius">12dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardElevation">1dp</item>
        <item name="cardMaxElevation">1dp</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardBackgroundColor">?attr/contentColorPrimary</item>
        <item name="contentPadding">0dp</item>
    </style>

    <style name="CardView.Reactive" parent="CardView.Normal">
        <item name="cardBackgroundColor">?attr/contentColorReactive</item>
    </style>

    <!-- M3 风格搜索栏:stadium 全圆角(56dp 行高一半),扁平 tonal 容器无投影 -->
    <style name="CardView.SearchBar">
        <item name="cardCornerRadius">28dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="cardElevation">0dp</item>
        <item name="cardMaxElevation">0dp</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardBackgroundColor">?attr/searchBarContainerColor</item>
        <item name="contentPadding">0dp</item>
    </style>

    <!-- M3 Outlined 文本框:12dp 全圆角描边;经主题 textInputStyle 全局生效 -->
    <style name="Widget.App.TextInputLayout.OutlinedBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/textfield_stroke</item>
    </style>

    <!-- M3 FAB:16dp 圆角方形 -->
    <style name="ShapeAppearanceOverlay.App.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- iOS 风格对话框:28dp 圆角;M3 fade+scale 动效 -->
    <style name="GlassAlertDialog" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearance">@style/GlassDialogShape</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MaterialComponents.Button.TextButton.Dialog</item>
        <item name="android:windowAnimationStyle">@style/GlassDialogAnimation</item>
    </style>

    <style name="GlassDialogShape" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ClipTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="textAllCaps">false</item>
        <item name="buttonStyle">?android:attr/borderlessButtonStyle</item>
        <item name="android:fontFamily">@dimen/text_more_super_small</item>
    </style>

    <style name="CustomChipChoice" parent="@style/Widget.MaterialComponents.Chip.Action">
        <item name="textColor">@android:color/white</item>
        <!--        <item name="android:textColor">@color/text_color_chip_state_list</item>-->
    </style>

    <style name="ThemeChangeButtonStyleLight" parent="@style/Widget.AppCompat.Button.Borderless.Colored">
        <item name="textColor">@color/colorAccent</item>
        <item name="backgroundColor">@color/white</item>
    </style>

    <style name="ThemeChangeButtonStyleDark" parent="@style/Widget.AppCompat.Button.Borderless.Colored">
        <item name="textColor">@color/colorPrimary</item>
        <item name="backgroundColor">@color/grey_850</item>
    </style>

    <style name="ThemeChangeButtonStyleBlack" parent="@style/Widget.AppCompat.Button.Borderless.Colored">
        <item name="textColor">@color/colorPrimary</item>
        <item name="backgroundColor">@color/black</item>

    </style>

    <!--  组件动画:M3 弹出菜单锚点 fade+scale  -->
    <style name="PopupWindow">
        <item name="android:windowEnterAnimation">@anim/popup_menu_enter</item>
        <item name="android:windowExitAnimation">@anim/popup_menu_exit</item>
    </style>

    <!--  M3 Activity 转场:forward/back slide+fade  -->
    <style name="GlassActivityAnimation" parent="android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_close_exit</item>
    </style>

    <!--  M3 对话框动效:fade+scale  -->
    <style name="GlassDialogAnimation" parent="android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <style name="Widget.AppTheme.ButtonBar.Fullscreen" parent="">
        <item name="android:background">@color/black_overlay</item>
        <item name="android:buttonBarStyle">?android:attr/buttonBarStyle</item>
    </style>
    <style name="Widget.Ehviewer.AppWidget.Container" parent="android:Widget">
        <item name="android:id">@android:id/background</item>
        <item name="android:background">?android:attr/colorBackground</item>
    </style>

    <style name="Widget.Ehviewer.AppWidget.InnerView" parent="android:Widget">
        <item name="android:background">?android:attr/colorBackground</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <!-- 「更多」场景入口行 -->
    <style name="MoreEntryRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <style name="MoreEntryIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginRight">20dp</item>
        <item name="android:tint">?android:attr/textColorSecondary</item>
    </style>

    <style name="MoreEntryLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
