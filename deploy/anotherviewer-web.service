# ===========================================================================
# AnotherViewer Web — systemd service unit
#
# Install:
#   sudo cp deploy/anotherviewer-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now anotherviewer-web
#
# Logs:
#   journalctl -u anotherviewer-web -f
# ===========================================================================

[Unit]
Description=AnotherViewer Web Server
Documentation=https://github.com/SXJ-Li/Anotherviewer_CN_SXJ
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anotherviewer
Group=anotherviewer

# JAR 位置——按实际部署路径调整（绝对路径，不用通配符）
ExecStart=/usr/bin/java \
    -Xms256m -Xmx1024m \
    -XX:+UseG1GC \
    -jar /opt/anotherviewer/anotherviewer-web.jar \
    --server.port=8080

WorkingDirectory=/opt/anotherviewer

# data-dir 固定派生不变量：anotherviewer.db / security.key / downloads/ / cache/ /
# backups/ 全部由该目录派生，无需（也不应）再单独传 download.path、cache-path、
# encryption-key-path 等键（旧的 data/db 嵌套语义已废弃，见 docs/deployment.md）。
Environment=ANOTHERVIEWER_DATA_DIR=/opt/anotherviewer/data
Environment=JAVA_HOME=/usr/lib/jvm/java-21-openjdk

# Restart policy
Restart=on-failure
RestartSec=10
SuccessExitStatus=143

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/anotherviewer/data
PrivateTmp=true

# Resource limits
LimitNOFILE=65536
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
