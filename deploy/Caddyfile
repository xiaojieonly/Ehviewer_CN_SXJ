# ===========================================================================
# AnotherViewer Web — Caddy reverse proxy with automatic HTTPS
#
# Caddy automatically obtains and renews Let's Encrypt certificates.
# Install: https://caddyserver.com/docs/install
#
# Usage:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Replace "anotherviewer.example.com" with your actual domain.
# For LAN-only access without HTTPS, use the HTTP-only block below.
# ===========================================================================

# --- HTTPS (recommended for PWA — Service Worker requires secure context) ---
anotherviewer.example.com {
    reverse_proxy localhost:8080 {
        # 让服务端看到真实客户端 IP（登录限流按 IP 分桶依赖它）。
        header_up X-Forwarded-For {remote_host}
    }

    # WebSocket support (STOMP over SockJS)
    @websocket {
        path /ws/*
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websocket localhost:8080 {
        header_up X-Forwarded-For {remote_host}
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Gzip compression for text assets
    encode gzip zstd

    # Cache static assets (content-hashed by Vite)
    @static path /assets/*
    header @static Cache-Control "public, max-age=31536000, immutable"

    # API responses — short cache
    @api path /api/*
    header @api Cache-Control "no-cache"

    # Access log
    log {
        output file /var/log/caddy/anotherviewer-access.log
        format json
    }
}

# --- HTTP-only (LAN access, no domain needed) ---
# Uncomment this block and comment out the HTTPS block above for LAN-only use.
# Note: PWA features (Service Worker) will NOT work without HTTPS or localhost.
#
# :80 {
#     reverse_proxy localhost:8080 {
#         header_up X-Forwarded-For {remote_host}
#     }
#
#     @websocket {
#         path /ws/*
#         header Connection *Upgrade*
#         header Upgrade websocket
#     }
#     reverse_proxy @websocket localhost:8080 {
#         header_up X-Forwarded-For {remote_host}
#     }
#
#     encode gzip zstd
# }
