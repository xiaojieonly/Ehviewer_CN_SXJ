# Build outputs
build/
ehviewer-core/build/
*.class
*.jar
*.war

# Gradle
.gradle/
.gradle-user-home/
# 注意：不能写 gradle/（目录级排除会让 git 不再下钻，下面的豁免全部失效）；
# gradle/* 只排除其直接子项，配合显式豁免保住必须入库的 gradle wrapper
gradle/*
!gradle/wrapper/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# IDE
.idea/
*.iml
.vscode/
.codewhale/
.deepseek/

# AI 工具运行目录
.claude/
.mimocode/

# Android
local.properties
app/.cxx/

# Qwen Code
.qwen/

# Node
node_modules/
web-frontend/dist/

# Data
data/
data-dev-backup/
*.db
.dev-data/*
!.dev-data/.gitkeep

# Kotlin
.kotlin/

# Logs
*.log
*.pid

# OS
.DS_Store
Thumbs.db

# Frontend coverage / test artifacts
web-frontend/coverage/
web-frontend/e2e/actual/
web-frontend/e2e/diff/
web-frontend/e2e/test-results/

# zip 发布包产物
/dist/
